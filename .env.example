# ═══════════════════════════════════════════════════
# Supabase Configuration — copy this to .env
# ═══════════════════════════════════════════════════

# Frontend (Vite) — used by the React dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Camera clips: "local" streams /videos-local/<slug>.mp4 (run
# `python3 pipeline/tools/link_local_videos.py` first), "supabase" streams
# videos/mumbai/720p/<slug>.mp4 from Supabase Storage.
# Default: local in `npm run dev`, supabase in production builds.
# VITE_VIDEO_SOURCE=local

# Backend (Python pipeline) — used by pipeline/insert_detections.py
# The service role key bypasses Row Level Security (RLS) and
# is required for trusted backend bulk insert operations.
# Find it in: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ═══════════════════════════════════════════════════
# Server-only (never prefix with VITE_)
# Trained YOLOv7-tiny ANPR model API on the team's GPU machine.
# ═══════════════════════════════════════════════════
# These are read ONLY by the Vercel serverless functions in api/ (/api/detect,
# /api/health) and by pipeline/detect/run_remote_detection.py. Anything with a
# VITE_ prefix is compiled into the public browser bundle — so NEVER rename
# these to VITE_*, and never import them from src/.
#
# Production / preview: Vercel → Project Settings → Environment Variables
#   add each variable below (Production + Preview), then redeploy.
# Local: put them in .env at the repo root and run `vercel dev` (serves the
#   Vite app AND api/ on one port). Plain `npm run dev` has no /api routes.
#   For offline testing, run `python pipeline/detect/mock_model_server.py`
#   and point DETECTION_API_URL at http://127.0.0.1:8765/detect with key dev-key.

# Full URL of the model's detect endpoint (POST), e.g. https://gpu.example.org/detect
DETECTION_API_URL=
# Secret API key for the model API
DETECTION_API_KEY=
# Header that carries the key. "Authorization" (default) sends "Bearer <key>";
# any other header name (e.g. x-api-key) sends the raw key.
DETECTION_API_AUTH_HEADER=Authorization
# Upstream timeout per frame in milliseconds
DETECTION_API_TIMEOUT_MS=15000
# Optional — how frames are sent upstream: multipart (default) | json | raw
# DETECTION_API_REQUEST_FORMAT=multipart
# Optional — image field name for multipart/json requests (default: image)
# DETECTION_API_IMAGE_FIELD=image
# Optional — health probe URL used by /api/health (default: <origin>/health)
# DETECTION_API_HEALTH_URL=
