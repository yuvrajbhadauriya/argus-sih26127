# ═══════════════════════════════════════════════════
# Supabase Configuration — copy this to .env
# ═══════════════════════════════════════════════════

# Frontend (Vite) — used by the React dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Camera clips: "local" streams /videos-local/<slug>.mp4 (run
# `python3 pipeline/tools/link_local_videos.py` first), "supabase" streams
# videos/mumbai/720p/<slug>.mp4 from Supabase Storage.
# Default: local in `npm run dev`, supabase in production builds.
# VITE_VIDEO_SOURCE=local

# Backend (Python pipeline) — used by pipeline/insert_detections.py
# The service role key bypasses Row Level Security (RLS) and
# is required for trusted backend bulk insert operations.
# Find it in: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ═══════════════════════════════════════════════════
# Server-only (never prefix with VITE_)
# The team's LPU ANPR model API on the GPU box: DEIM detector (deim50k) +
# PARSeq OCR (raw35), engine "lpu_on_gpu". See pipeline/detect/README.md.
# ═══════════════════════════════════════════════════
# The model API listens on the team's Tailscale/LAN address only. Per its
# README and the DPDP Act it must NEVER be exposed publicly (no public tunnels).
#
# Read ONLY by server code: the serverless functions in api/ (/api/detect,
# /api/health), the `npm run dev` bridge that mounts them locally
# (api/_lib/viteDevBridge.ts — reads .env server-side, nothing reaches the
# browser), and pipeline/detect/run_remote_detection.py. Anything with a
# VITE_ prefix is compiled into the public browser bundle — so NEVER rename
# these to VITE_*, and never import them from src/.
#
# Local (on the team network / Tailscale): put the values in .env
# (chmod 600) and run `npm run dev` — the Live-detect button then works.
# Vercel: the deployment cannot reach a Tailscale-only host, so leave these
# unset there; /api/detect answers 503 and the Cameras page says the model API
# is LAN/VPN-only. Only set them on Vercel if the team runs a PRIVATE,
# authenticated tunnel it controls.
# Offline testing: `python3 pipeline/detect/mock_model_server.py --port 8766`
# and DETECTION_API_URL=http://127.0.0.1:8766/v1/frame, DETECTION_API_KEY=dev-key.

# Base URL of the model API, e.g. http://<tailscale-ip>:8765 (used when
# DETECTION_API_URL is unset, and for /v1/video + /health)
ANPR_API_BASE=
# Frame endpoint (POST raw JPEG/PNG), e.g. http://<tailscale-ip>:8765/v1/frame
DETECTION_API_URL=
# Secret API key for the model API (rotate with ./run_api.sh rotate on the GPU box)
DETECTION_API_KEY=
# Header that carries the key: X-API-Key (default, raw key) or Authorization (sends "Bearer <key>")
DETECTION_API_AUTH_HEADER=X-API-Key
# Query sent with every /api/detect frame. Wide overhead city views need tiles=2x3.
# DETECTION_API_QUERY=tiles=2x3&roi_top=0.33&min_conf=60
# Upstream timeout per frame in milliseconds (a tiled 1080p frame takes ~0.5-1.5 s)
DETECTION_API_TIMEOUT_MS=15000
# Optional — health probe URL used by /api/health (default: <origin>/health)
# DETECTION_API_HEALTH_URL=
# Optional — legacy servers only: request body format raw (default) | multipart | json
# DETECTION_API_REQUEST_FORMAT=raw
